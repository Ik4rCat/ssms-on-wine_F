<Project Sdk="Microsoft.NET.Sdk">
  <!-- A tiny .NET library that embeds a GIF resource so the patcher has
       something realistic to chew on. Built at test time; not shipped. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Testasm.Explorer</AssemblyName>
    <RootNamespace>Testasm</RootNamespace>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0219;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Testasm.cs" />
    <EmbeddedResource Include="spin1.gif">
      <LogicalName>Testasm.spin1.gif</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
